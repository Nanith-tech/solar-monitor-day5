# Copy to .env or run npm run setup. Never share the resulting private .env.
HOST=0.0.0.0
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/solar_monitor
DEVICE_ID=solar-node-001
DEVICE_NAME=Solar panel 1
DEVICE_KEY=replace-with-at-least-32-random-characters
OFFLINE_AFTER_MS=20000
CORS_ORIGIN=http://localhost:5173
# Sensor capacity bounds, not the panel's nominal ratings:
MAX_VOLTAGE_V=26
MAX_CURRENT_MA=3200
MAX_POWER_MW=83200
# Simulator is opt-in; real sensor data is always supported.
ALLOW_SIMULATOR=false
SIMULATOR_INTERVAL_MS=5000

# Automatic ESP32 laptop discovery on the same LAN/hotspot. No key is advertised.
DISCOVERY_ENABLED=true
DISCOVERY_HOST=solar-laptop
