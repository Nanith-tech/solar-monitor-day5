# Public browser settings only. Never copy DEVICE_KEY or Atlas credentials here.
# Defaults work without creating this file.
VITE_API_BASE_URL=/api/v1
VITE_DEVICE_ID=solar-node-001
VITE_POLL_INTERVAL_MS=5000
# Used by Vite's local proxy; change if your Express PORT changes.
SOLAR_API_TARGET=http://127.0.0.1:4000
# Optional socket origin when using a direct API URL; default uses page origin.
# VITE_SOCKET_URL=http://localhost:4000
