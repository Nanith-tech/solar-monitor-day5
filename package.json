{
  "name": "solar-monitor",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "npm run start --workspace server",
    "dev": "npm run dev --workspace server",
    "simulate": "node scripts/simulate-device.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "test": "npm run test --workspace server",
    "check": "node scripts/check-syntax.mjs",
    "client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "preview": "npm run preview --workspace client",
    "test:client": "npm run test --workspace client",
    "test:server:unit": "npm run test:unit --workspace server",
    "doctor": "node scripts/doctor.mjs",
    "test:firmware": "node scripts/test-firmware.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "test:discovery:network": "node scripts/test-discovery-network.mjs",
    "wifi:setup": "node scripts/dev-all.mjs --wifi-setup"
  }
}
